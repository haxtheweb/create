          "file": "system/backend/php/vendor/icamys/php-sitemap-generator/src/SitemapGenerator.php",
          "why": "the bundled sitemap library calls SplFixedArray::key(), removed in PHP 8; this commit required PHP ^7.1. Patched in the throwaway copy only, so it runs on PHP 8.",
          "replace": [
            ["$this->urls->key()", "($this->urlsKey ?? 0)"],
            [
              "$this->urls->next();",
              "$this->urlsKey = ($this->urlsKey ?? 0) + 1;"
            ]
          ]
        }
