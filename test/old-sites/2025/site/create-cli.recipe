cli: hax site old-site-2025 --theme "clean-one"
cli: hax site node:add --title "Getting started" --content "<h2 data-accent="1">About this site</h2><p data-design-treatment="dropCap-md">Made with the <strong>HAX CLI</strong> as of 2025.</p><grid-plate layout="1-1"><p slot="col-1">Left.</p><p slot="col-2">Right.</p></grid-plate><video-player source="https://www.youtube.com/watch?v=LrS7dqokTLE"></video-player>" --domain "haxcli-old-site-2025.surge.sh"
cli: hax site node:add --title "Unit 1" --content "<h2>Unit 1 overview</h2><p data-primary="3">One lesson below.</p><simple-cta link="https://haxtheweb.org/" label="Learn more"></simple-cta>" --domain "haxcli-old-site-2025.surge.sh"
cli: hax site node:add --title "Lesson 1" --content "<h3>Lesson 1</h3><p>A page one level deep.</p><a11y-collapse heading-button><p slot="heading">More</p><div slot="content"><p>Hidden text.</p></div></a11y-collapse><self-check title="Quick check"><p slot="question">Still here?</p><p>Yes.</p></self-check>" --domain "haxcli-old-site-2025.surge.sh"
cli: hax site node:add --title "Resources" --content "<h2>Resources</h2><ul><li><a href="https://haxtheweb.org/">HAXTheWeb</a></li></ul>" --domain "haxcli-old-site-2025.surge.sh"
