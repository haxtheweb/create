{
  "name": "@haxtheweb/create",
  "version": "26.8.1",
  "publishConfig": {
    "access": "public"
  },
  "description": "CLI for all things HAX the web",
  "author": "HAXTheWeb core team",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18.20.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/haxtheweb/create.git"
  },
  "bugs": {
    "url": "https://github.com/haxtheweb/issues/issues"
  },
  "homepage": "https://hax.psu.edu/",
  "scripts": {
    "prepare": "husky install",
    "build": "rm -rf dist && babel src --out-dir dist --copy-files --include-dotfiles && chmod 774 dist/create.js",
    "start": "npm run build && node ./dist/create.js && chmod 774 dist/create.js",
    "release": "npm run build && commit-and-tag-version && git push --follow-tags origin main && npm publish",
    "hax": "hax",
    "dev": "nodemon --watch src",
    "haxcms-nodejs": "haxcms-nodejs",
    "local": "npm run build && npm link",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "precheck": "node scripts/precheck.mjs",
    "precheck:fix": "node scripts/precheck.mjs --fix",
    "test": "node --require ./test/_helpers/english.cjs --test test/unit/**/*.test.cjs test/smoke/**/*.test.cjs",
    "test:unit": "node --require ./test/_helpers/english.cjs --test test/unit/**/*.test.cjs",
    "test:smoke": "node --require ./test/_helpers/english.cjs --test test/smoke/**/*.test.cjs",
    "test:coverage": "c8 --all --include='src/create.js' --include='src/lib/**' --exclude='test/**' --exclude='dist/**' --reporter=text --reporter=lcov --report-dir=coverage node --require ./test/_helpers/english.cjs --test test/unit/**/*.test.cjs test/smoke/**/*.test.cjs"
  },
  "man": [
    "./dist/docs/hax.1"
  ],
  "bin": {
    "create-haxtheweb": "./dist/create.js",
    "hax": "./dist/create.js"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "webcomponents",
    "html",
    "lit",
    "haxtheweb"
  ],
  "dependencies": {
    "@clack/core": "1.3.1",
    "@clack/prompts": "1.4.0",
    "@haxtheweb/haxcms-nodejs": "^26.8.0",
    "@lit-labs/ssr": "4.1.0",
    "acorn": "8.15.0",
    "acorn-walk": "8.3.4",
    "commander": "14.0.3",
    "ejs": "5.0.2",
    "js-yaml": "4.3.2",
    "node-html-parser": "7.1.0",
    "open": "11.0.0",
    "picocolors": "1.1.1",
    "twig": "3.0.0",
    "winston": "3.19.0"
  },
  "overrides": {
    "js-yaml": "4.3.2",
    "multer": "^2.4.0",
    "markdown-it": "^14.3.1",
    "ws": "8.21.3",
    "sharp": "0.35.5",
    "image-size": "^2.0.4"
  },
  "devDependencies": {
    "@babel/cli": "7.28.6",
    "@babel/core": "^7.29.7",
    "@babel/plugin-syntax-import-attributes": "7.28.6",
    "@babel/preset-env": "7.29.5",
    "@babel/register": "7.29.3",
    "@custom-elements-manifest/analyzer": "0.10.4",
    "@eslint/js": "9.39.5",
    "babel-plugin-transform-dynamic-import": "2.1.0",
    "c8": "10.1.3",
    "commit-and-tag-version": "12.7.3",
    "eslint": "9.39.5",
    "fast-check": "4.10.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-n": "18.5.0",
    "globals": "17.13.0",
    "husky": "7.0.4",
    "lint-staged": "^15.5.2",
    "nodemon": "3.1.14",
    "prettier": "3.2.5"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ]
  }
}
